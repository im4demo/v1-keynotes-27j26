# Compose-level variables (used by docker-compose.yml when running
# `docker compose up` locally, and set as project env vars in Dokploy's
# UI for production). Copy to `.env` for local use; never commit `.env`.

# --- db ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=keynotes

# --- api ---
# Must match the db credentials above when running the full stack via compose.
DATABASE_URL=postgresql://postgres:postgres@db:5432/keynotes

# --- web ---
# Browser-facing API URL. Baked into the web app's JS bundle at BUILD time
# (Next.js NEXT_PUBLIC_* behavior) — set this to the real public api.<domain>
# in Dokploy BEFORE building for production, not just as a runtime env var.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- website ---
# Baked into the website app's JS bundle at BUILD time, same caveat as above.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
